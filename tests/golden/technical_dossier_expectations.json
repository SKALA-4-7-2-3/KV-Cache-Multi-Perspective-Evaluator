{
  "schema_version": "1.0.0",
  "papers": [
    {
      "selector": {
        "paper_id_regex": "^2605\\.08317(?:-|$)"
      },
      "expectations": [
        {
          "expectation_id": "rdkv.mean-improvement",
          "description": "세 평가군의 평균 9.1% 개선",
          "all_of": ["9[.]1\\s*%"]
        },
        {
          "expectation_id": "rdkv.accuracy-at-retention",
          "description": "2.48% cache retention에서 97.81% full-cache accuracy",
          "all_of": ["97[.]81\\s*%", "2[.]48\\s*%"]
        },
        {
          "expectation_id": "rdkv.decode-speedup-128k",
          "description": "128K 조건의 4.5배 decode speedup",
          "all_of": ["128\\s*K", "4[.]5\\s*[x×]", "(?:decode|디코드|speedup)"]
        },
        {
          "expectation_id": "rdkv.memory-reduction-128k",
          "description": "128K 조건의 1.9배 peak-memory reduction",
          "all_of": ["128\\s*K", "1[.]9\\s*[x×]", "(?:memory|메모리)"]
        },
        {
          "expectation_id": "rdkv.memory-absolute-128k",
          "description": "128K에서 FullKV 58.1GB와 RDKV 30.5GB",
          "all_of": ["58[.]1\\s*GB", "30[.]5\\s*GB"]
        },
        {
          "expectation_id": "rdkv.256k-result",
          "description": "256K에서 RDKV 44.5GB 실행 결과",
          "all_of": ["256\\s*K", "44[.]5", "(?:GB|memory|메모리)"]
        },
        {
          "expectation_id": "rdkv.prefill-overhead",
          "description": "prefill overhead 6%",
          "all_of": ["6(?:[.]0)?\\s*%", "(?:prefill|overhead|오버헤드)"]
        },
        {
          "expectation_id": "rdkv.frozen-after-prefill",
          "description": "prefill 뒤 allocation을 갱신하지 않는 한계",
          "all_of": ["(?:prefill|프리필)", "(?:frozen|재평가하지|갱신하지|고정)"]
        }
      ]
    },
    {
      "selector": {
        "paper_id_regex": "^2607\\.27187(?:-|$)"
      },
      "expectations": [
        {
          "expectation_id": "pf.table1-batch-set",
          "description": "Table I 공통 batch size 1, 2, 8, 16, 32",
          "all_of": ["(?:batch|배치)", "\\{?\\s*1\\s*,\\s*2\\s*,\\s*8\\s*,\\s*16\\s*,\\s*32\\s*\\}?"]
        },
        {
          "expectation_id": "pf.table1-standard-context",
          "description": "Table I 표준 context 1K–100K",
          "all_of": ["(?:standard|표준)", "1\\s*K\\s*[-–—−]\\s*100\\s*K"]
        },
        {
          "expectation_id": "pf.table1-maverick-context",
          "description": "Maverick context 최대 1M",
          "all_of": ["Maverick", "1\\s*M"]
        },
        {
          "expectation_id": "pf.table1-scout-context",
          "description": "Scout context 최대 4M",
          "all_of": ["Scout", "4\\s*M"]
        },
        {
          "expectation_id": "pf.table1-8b-a100-host",
