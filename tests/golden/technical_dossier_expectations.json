        },
        {
          "expectation_id": "pf.table1-maverick-disk-na",
          "description": "Maverick 8×H200 disk는 미시험",
          "all_of": ["Maverick", "8\\s*[x×]\\s*H200", "(?:disk|storage|SSD)"],
          "any_of": ["not[ -]?tested", "미(?:시험|평가|측정)", "측정되지", "—"]
        },
        {
          "expectation_id": "pf.table1-scout-host",
          "description": "Scout 8×H200 host-memory 2.6×–54.6×",
          "all_of": ["Scout", "8\\s*[x×]\\s*H200", "2[.]6\\s*[x×]\\s*[-–—−]\\s*54[.]6\\s*[x×]"]
        },
        {
          "expectation_id": "pf.table1-scout-disk-na",
          "description": "Scout 8×H200 disk는 미시험",
          "all_of": ["Scout", "8\\s*[x×]\\s*H200", "(?:disk|storage|SSD)"],
          "any_of": ["not[ -]?tested", "미(?:시험|평가|측정)", "측정되지", "—"]
        },
        {
          "expectation_id": "pf.appliance-capacity-topology-bandwidth",
          "description": "32TB/16 hosts/128GB/s-host 설계 조건",
          "all_of": ["32\\s*TB", "16(?:[- ]?host|\\s*hosts|개\\s*host)", "128\\s*GB\\s*/\\s*s"]
        },
        {
          "expectation_id": "pf.emulation-result",
          "description": "hardware emulation 결과를 별도로 명시",
          "all_of": ["emulat", "350\\s*ns"]
        },
        {
          "expectation_id": "pf.simulation-result",
          "description": "serving simulation 결과를 별도로 명시",
          "all_of": ["simulat", "(?:2[,]?690\\s*ms|6[.]6\\s*[x×])"]
        },
        {
          "expectation_id": "pf.physical-e2e-pending",
          "description": "physical end-to-end 미검증 한계",
          "all_of": ["(?:physical|물리)", "end[- ]?to[- ]?end", "(?:pending|미검증|검증.*(?:않|예정))"]
