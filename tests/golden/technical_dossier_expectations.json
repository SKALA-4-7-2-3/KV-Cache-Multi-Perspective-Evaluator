          "all_of": ["LLaMA[- ]?70B", "2\\s*[x×]\\s*H200", "(?:disk|storage|SSD)"],
          "any_of": ["not[ -]?tested", "미(?:시험|평가|측정)", "측정되지", "—"]
        },
        {
          "expectation_id": "pf.table1-405b-h200-host",
